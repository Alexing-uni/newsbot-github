# Copia este fichero a .env (está en .gitignore). Nunca subas claves al repositorio.
# En modo papel todo es opcional.

# Lectura de noticias con un modelo de lenguaje (opcional; sin clave usa FinBERT o un léxico)
ANTHROPIC_API_KEY=

# Telegram: propuestas con botones ✅/❌ y comandos (/estado, /pensamiento...).
# Crea el bot con @BotFather; tu chat id con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Solo para dinero real ----------------------------------------------------------------------
# Las claves deben tener permiso de operar, NUNCA de retirar fondos.
CONFIRM_LIVE=no
# Bolsa (Trading 212, API pública v0)
TRADING212_API_KEY=
TRADING212_API_SECRET=
# Cripto (Bitvavo)
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
# Opcional: CryptoPanic (sin plan gratuito de API; sin token se omite)
CRYPTOPANIC_TOKEN=
